# GeoGround AI — .gitignore

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/

# ─── Environment & Secrets ──────────────────────────────────────────────────
.env
*.env.local
*.env.production

# ─── Data files ─────────────────────────────────────────────────────────────
ml/data/raw/
ml/data/processed/
ml/data/external/
*.csv
*.parquet
*.h5
*.nc

# ─── Trained models ─────────────────────────────────────────────────────────
ml/models/*.pkl
ml/models/*.ubj
ml/models/*.json

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
dist/
.next/
.cache/

# ─── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Office & Temporary ───────────────────────────────────────────────────
~$*
*.tmp
*.temp

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Docker ─────────────────────────────────────────────────────────────────
.docker/

# ─── Keep these directories (add .gitkeep) ──────────────────────────────────
!ml/data/raw/.gitkeep
!ml/data/processed/.gitkeep
!ml/data/external/.gitkeep
!ml/models/.gitkeep
