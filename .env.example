# GeoGround AI — Environment Variables Template
# Copy this to .env and fill in actual values
# Never commit .env to version control

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/geoground_ai

# ─── ML Service ─────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000

# ─── NestJS Backend ─────────────────────────────────────────────────────────
BACKEND_PORT=3001
JWT_SECRET=your-jwt-secret-here

# ─── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# ─── External Data APIs ─────────────────────────────────────────────────────
# NASA POWER API — No key required (free public API)
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point

# SoilGrids (ISRIC) — No key required
SOILGRIDS_BASE_URL=https://files.isric.org/soilgrids/latest/data

# ESA WorldCover — No key required (AWS S3 public)
WORLDCOVER_S3_BUCKET=s3://esa-worldcover/v200/2021/map

# NASA SRTM Elevation — No key required (public AWS)
SRTM_API_BASE=https://api.opentopodata.org/v1/srtm30m

# Nominatim Reverse Geocoding (OpenStreetMap) — No key, respect rate limits
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_EMAIL=your-email@example.com

# ─── Study Area Configuration ───────────────────────────────────────────────
DEFAULT_STUDY_DISTRICT=Hyderabad
DEFAULT_SEARCH_RADIUS_KM=15
MAX_SEARCH_RADIUS_KM=50

# ─── ML Model ───────────────────────────────────────────────────────────────
MODEL_PATH=./ml/models/best_model.ubj
PREPROCESSOR_PATH=./ml/models/preprocessor.pkl
